{
  "$schema": "https://neutralino.js.org/schemas/neutralino.config.json",
  "applicationId": "com.bluesparkmz.skypdv",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "modes": {
    "window": {
      "title": "SkyPDV",
      "width": 1200,
      "height": 800,
      "minWidth": 900,
      "minHeight": 600,
      "center": true,
      "resizable": true,
      "fullscreen": false
    }
  },
  "cli": {
    "binaryName": "SkyPDV",
    "resourcesPath": "/dist/",
    "distributionPath": "/release/",
    "frontendLibrary": {
      "patchFile": "/index.html",
      "devUrl": "http://localhost:8080"
    },
    "hostProject": {
      "projectPath": "/",
      "devCommand": "npm run dev",
      "buildCommand": "npm run build",
      "buildPath": "/dist/"
    },
    "binaryVersion": "6.9.0"
  }
}
